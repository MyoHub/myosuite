<mujoco model="boxing_mannequin_scene">
  <compiler angle="radian" coordinate="local" inertiafromgeom="auto" meshdir="." autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.15 0.18 0.22" rgb2="0.02 0.03 0.04" width="512" height="512"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.16 0.16 0.16" rgb2="0.12 0.12 0.12" width="256" height="256"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="6 6" texuniform="true" reflectance="0.1"/>
    <material name="mannequin_mat" rgba="0.75 0.68 0.58 1.0" specular="0.1" shininess="0.2"/>
    <material name="head_mat" rgba="0.80 0.72 0.62 1.0" specular="0.1" shininess="0.2"/>
    <material name="glove_r_mat" rgba="0.84 0.14 0.14 1.0" specular="0.2" shininess="0.3"/>
    <material name="glove_l_mat" rgba="0.14 0.18 0.84 1.0" specular="0.2" shininess="0.3"/>
    <mesh name="mannequin_mesh" file="BoxingDummy.stl" scale="1.1 1.1 1.1"/>
    <mesh name="glove_r_mesh" file="boxing_glove_r.stl" scale="0.06 0.06 0.06"/>
    <mesh name="glove_l_mesh" file="boxing_glove_r.stl" scale="-0.06 0.06 0.06"/>
  </asset>

  <default>
    <geom friction="0.8 0.1 0.02" solref="0.003 1" solimp="0.95 0.98 0.001"/>
    <joint damping="20" armature="0.01"/>
    <position kp="1800" kv="90" ctrllimited="true"/>
  </default>

  <worldbody>
    <light directional="true" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <geom name="floor" type="plane" pos="0 0 0" size="5 5 0.1" material="floor_mat" contype="1" conaffinity="1"/>

    <!-- Root body with XY planar translation control. -->
    <body name="mannequin" pos="0 0 0.0">
      <joint name="mannequin_x" type="slide" axis="1 0 0" range="-1.5 1.5"/>
      <joint name="mannequin_y" type="slide" axis="0 1 0" range="-1.5 1.5"/>
      <joint name="mannequin_rotation" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
      <geom name="mannequin_visual" type="mesh" mesh="mannequin_mesh" material="mannequin_mat" contype="0" conaffinity="0"/>
      <geom name="mannequin_chest_collision" type="ellipsoid" pos="0.0 0.07 1.33" size="0.35 0.17 0.17"/>
      <geom name="mannequin_waist_collision" type="ellipsoid" pos="0.0 0.035 1.05" size="0.23 0.17 0.25"/>
      <geom name="mannequin_head_collision" type="sphere" pos="0.0 0.025 1.68" size="0.17" mass="4.0" material="head_mat"/>

      <!-- Main observation sites -->
      <site name="mannequin_com_site" pos="0 0 1.508" size="0.015" rgba="1 1 0 0.8"/>
      <site name="mannequin_head_hit_site" type="sphere" pos="0.0 0.025 1.68" size="0.17" rgba="1 0.2 0.2 0.25"/>
      <site name="mannequin_chest_hit_site" type="ellipsoid" pos="0.0 0.07 1.33" size="0.35 0.17 0.17" rgba="0.2 1 0.2 0.2"/>
      <site name="mannequin_waist_hit_site" type="ellipsoid" pos="0.0 0.035 1.05" size="0.23 0.17 0.25" rgba="0.2 1 0.2 0.2"/>

      <body name="right_glove_anchor" pos="0.402 0.126 1.068">
        <joint name="right_glove_x" type="slide" axis="1 0 0" range="-0.65 0"/>
        <joint name="right_glove_y" type="slide" axis="0 1 0" range="0 0.55"/>
        <joint name="right_glove_z" type="slide" axis="0 0 1" range="0 0.45"/>
        <geom name="right_glove_visual" type="mesh" mesh="glove_r_mesh" material="glove_r_mat" contype="0" conaffinity="0"/>
        <geom name="right_glove_collision" type="sphere" pos="0.0 0.082 -0.006" size="0.07" mass="1.2" rgba="0.84 0.14 0.14 0.15"/>
        <site name="right_glove_site" pos="0.05 0 0.013" size="0.012" rgba="0.9 0 0 1"/>
      </body>

      <body name="left_glove_anchor" pos="-0.402 0.126 1.068">
        <joint name="left_glove_x" type="slide" axis="1 0 0" range="0 0.65"/>
        <joint name="left_glove_y" type="slide" axis="0 1 0" range="0 0.55"/>
        <joint name="left_glove_z" type="slide" axis="0 0 1" range="0 0.45"/>
        <geom name="left_glove_visual" type="mesh" mesh="glove_l_mesh" material="glove_l_mat" contype="0" conaffinity="0"/>
        <geom name="left_glove_collision" type="sphere" pos="-0.0 0.082 -0.006" size="0.07" mass="1.2" rgba="0.14 0.18 0.84 0.15"/>
        <site name="left_glove_site" pos="-0.05 0 0.013" size="0.012" rgba="0 0.1 0.9 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- XY planar motion -->
    <position name="mannequin_x_ctrl" joint="mannequin_x" ctrlrange="-1.5 1.5"/>
    <position name="mannequin_y_ctrl" joint="mannequin_y" ctrlrange="-1.5 1.5"/>
    <!-- XYZ right glove -->
    <position name="right_glove_x_ctrl" joint="right_glove_x" ctrlrange="-0.65 0"/>
    <position name="right_glove_y_ctrl" joint="right_glove_y" ctrlrange="-0 0.55"/>
    <position name="right_glove_z_ctrl" joint="right_glove_z" ctrlrange="-0 0.45"/>
    <!-- XYZ left glove -->
    <position name="left_glove_x_ctrl" joint="left_glove_x" ctrlrange="-0 0.65"/>
    <position name="left_glove_y_ctrl" joint="left_glove_y" ctrlrange="-0 0.55"/>
    <position name="left_glove_z_ctrl" joint="left_glove_z" ctrlrange="-0 0.45"/>
  </actuator>

  <sensor>
    <!-- COM pose -->
    <framepos name="mannequin_com_pos" objtype="site" objname="mannequin_com_site"/>
    <framequat name="mannequin_com_quat" objtype="body" objname="mannequin"/>

    <!-- Hit observations -->
    <touch name="hit_head" site="mannequin_head_hit_site"/>
    <touch name="hit_chest" site="mannequin_chest_hit_site"/>

    <!-- Glove XYZ position observations -->
    <framepos name="right_glove_pos" objtype="site" objname="right_glove_site"/>
    <framepos name="left_glove_pos" objtype="site" objname="left_glove_site"/>
  </sensor>

</mujoco>
